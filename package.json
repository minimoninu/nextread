{
  "name": "nextread",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "sync:hooks": "node scripts/sync-hooks.mjs",
    "check:data": "node scripts/check-data.mjs",
    "check:data:strict": "CHECK_DATA_STRICT=1 node scripts/check-data.mjs",
    "test:today-picks": "node scripts/test-today-picks.mjs",
    "test:book-awards": "node scripts/test-book-awards.mjs",
    "lint": "eslint .",
    "test:wizard-preferences": "node scripts/test-wizard-preferences.mjs",
    "test:lists-backup": "node scripts/test-lists-backup.mjs",
    "test": "npm run test:today-picks && npm run test:book-awards && npm run test:wizard-preferences && npm run test:lists-backup",
    "verify": "npm run lint && npm run check:data:strict && npm test && npm run build",
    "build:thumbs": "node scripts/build-thumbs.mjs",
    "build:data": "node scripts/build-data.mjs",
    "predev": "npm run build:data",
    "prebuild": "npm run build:data"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "postcss": "^8.4.24",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.3.2",
    "vite": "^4.3.9"
  }
}
